# Admin panel access
ADMIN_PASSWORD=
ADMIN_SECRET=

# Content database — set MONGODB_URI to store all site content in MongoDB.
# Leave it empty to store content as JSON files in the data/ folder instead.
MONGODB_URI=
MONGODB_DB=hope-consultants

# Contact form email delivery (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=

GMAIL_USER=
GMAIL_APP_PASSWORD=
JWT_SECRET=
ADMIN_OWNER_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=

# How many unverified admin sign-in requests may be waiting for an owner code at once.
# Each one expires by itself after 24 hours. Set to 0 to close registration entirely.
MAX_OPEN_ACCESS_REQUESTS=25
