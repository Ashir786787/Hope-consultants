# Admin panel access
ADMIN_PASSWORD=
ADMIN_SECRET=

# Content database — set MONGODB_URI to store all site content in MongoDB.
# Leave it empty to store content as JSON files in the data/ folder instead.
MONGODB_URI=
MONGODB_DB=hope-consultants

# Contact form email delivery (SMTP)
# Internal staff notifications go to CONTACT_TO by default.
# The contact form notification can be sent elsewhere with CONTACT_NOTIFY_TO.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=
CONTACT_NOTIFY_TO=

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Automatic student emails (onboarding + document submission confirmations).
# Sent from the onboarding@hopeconsultants.pk mailbox on the hosting mail server.
# Host mail.hopeconsultants.pk, port 465 connects over SSL automatically.
# ONBOARDING_SMTP_PASS is that mailbox's own email password.
ONBOARDING_SMTP_HOST=mail.hopeconsultants.pk
ONBOARDING_SMTP_PORT=465
ONBOARDING_SMTP_USER=onboarding@hopeconsultants.pk
ONBOARDING_SMTP_PASS=

JWT_SECRET=
ADMIN_OWNER_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=

# How many unverified admin sign-in requests may be waiting for an owner code at once.
# Each one expires by itself after 24 hours. Set to 0 to close registration entirely.
MAX_OPEN_ACCESS_REQUESTS=25
